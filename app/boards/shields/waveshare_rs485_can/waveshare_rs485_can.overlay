/* zephyr-uds-app/app/boards/shields/waveshare_rs485_can/waveshare_rs485_can.overlay */

/ {
    chosen {
        /* Weist dem zephyr-uds Modul den CAN-Controller zu */
        zephyr,canbus = &fdcan1;
    };

    /*
     * Kapselung des RS485-Richtungspins in einem separaten logischen Knoten,
     * um Konflikte mit dem st,stm32-usart Treiber-Binding zu vermeiden.
     */
    rs485_hardware_control {
        compatible = "gpio-keys";
        rs485_de: rs485_direction_enable {
            gpios = <&arduino_header 13 GPIO_ACTIVE_HIGH>; /* D7 (PA8) auf dem Nucleo */
            label = "RS485_TX_ENABLE";
        };
    };
};

/* 1. CAN-FD Controller Konfiguration */
&fdcan1 {
    status = "okay";
    pinctrl-0 = <&fdcan1_rx_pb8 &fdcan1_tx_pb9>;
    pinctrl-names = "default";
    bus-speed = <500000>; /* Standard-UDS Diagnosebitrate */

    /*
     * HIER DIE KORREKTUR:
     * Der erzwungene Kind-Knoten für den passiven Transceiver samt maximaler Bitrate.
     */
    can-transceiver {
        compatible = "can-transceiver-passive";
        max-bitrate = <1000000>; /* 1 Mbit/s Limit des Transceivers */
    };
};

/* 2. RS485 / UART Konfiguration */
&arduino_serial {
    status = "okay";
    current-speed = <9600>;
};
